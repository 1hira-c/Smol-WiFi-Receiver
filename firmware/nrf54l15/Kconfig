config SMOL_TEST_GENERATOR
	bool "Generate 16 synthetic trackers at 100 Hz each"
	default n
	help
	  Disables live RF after initialization and feeds deterministic RF-v2-style
	  records into the SPI report queue for soak and latency testing.

